# Demo deployment settings. Copy to deploy/demo/.env (never committed),
# fill the keys, then: chmod 600 .env

# --- Front door (Caddy) -------------------------------------------------------
# Server: market-desk-<ip-with-dashes>.sslip.io (e.g. market-desk-3-85-12-40.sslip.io)
# Local test: localhost
DOMAIN=localhost
DEMO_USER=demo
# base64 of a bcrypt hash (no "$" left for Compose to mangle):
#   docker run --rm caddy:2 caddy hash-password --plaintext 'YOUR_PASSWORD' | base64 -w0
DEMO_PASSWORD_HASH=

# --- Backend ------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
PINECONE_API_KEY=
# Index holding the 4 ingested annual reports.
PINECONE_INDEX_NAME=market-intel
TAVILY_API_KEY=

# Email stays simulated: an empty sender means nothing is ever sent.
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=0

# Research console endpoint (Market Desk / AG-UI).
COPILOT_ENABLED=true
# Must be exactly https://<DOMAIN>, or voice sessions are refused (403).
VOICE_ALLOWED_ORIGINS=https://localhost
API_URL=http://api:8000

# Optional: Claude fallback model when OpenAI keeps failing.
ANTHROPIC_API_KEY=
