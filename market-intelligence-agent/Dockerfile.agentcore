# ARM64 container image for AgentCore Runtime.
# Builds from the market-intelligence-agent/ directory as context.
# Exposes /ping + /invocations on :8080 per the AgentCore Runtime contract.

FROM --platform=linux/arm64 python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_LINK_MODE=copy \
    PYTHONPATH=/app

WORKDIR /app

# Install build essentials for any wheels lacking ARM64 prebuilts.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install deps first for layer caching. Uses the slim v1 requirements
# (text + MCP gateway only), NOT the full dev uv.lock.
COPY requirements.agentcore.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy the application code.
COPY app/ ./app/
COPY entrypoint.py ./entrypoint.py

# AgentCore Runtime contract: /ping + /invocations on :8080.
EXPOSE 8080

CMD ["python", "entrypoint.py"]
